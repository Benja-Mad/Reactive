extends Node
const World = preload("res://scripts/matter/world_matter.gd")
var world: Node3D
var checks: Dictionary = {}
var events: Array[String] = []

func _ready() -> void: call_deferred("run")
func check(key: String, condition: bool) -> void:
	checks[key] = condition
	if not condition: push_error("MATTER FAILED: " + key)
func frames(count: int = 2) -> void:
	for i in count: await get_tree().physics_frame
func create(point: Vector3 = Vector3(0,0.05,0)) -> int:
	var result: Dictionary = world.execute(1,"create",0,{"point": point})
	check("create_succeeds",result["ok"])
	return result.get("id",0)
func run() -> void:
	var floor_body := StaticBody3D.new()
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(60,1,60)
	shape.shape = box
	shape.position.y = -0.5
	floor_body.add_child(shape)
	add_child(floor_body)
	var player := Node3D.new()
	player.name = "Player"
	player.position = Vector3(-4,0,0)
	player.add_to_group("coop_players")
	add_child(player)
	var other := Node3D.new()
	other.set_multiplayer_authority(2)
	other.add_to_group("coop_players")
	add_child(other)
	world = World.new()
	world.name = "WorldMatter"
	add_child(world)
	world.matter_event.connect(func(event: Dictionary): events.append(event["kind"]))
	await frames()
	check("unknown_rejected",not world.execute(1,"combo_magic")["ok"])
	check("range_rejected",not world.execute(1,"create",0,{"point": Vector3(50,0,0)})["ok"])
	var id: int = create()
	var original_view: Node = world.views[id]
	check("water_not_breakable",not world.execute(1,"impact",id)["ok"])
	check("not_movable",not world.execute(1,"push",id,{"vector":Vector3.RIGHT})["ok"])
	check("foreign_owner_rejected",not world.execute(2,"remove",id)["ok"])
	check("coat_water",world.execute(1,"coat",id,{"coating":"nanites"})["ok"])
	check("duplicate_coat_rejected",not world.execute(1,"coat",id)["ok"])
	check("raise",world.execute(1,"raise",id,{"vector":Vector3.RIGHT})["ok"])
	var actor = preload("res://tests/matter/test_actor.gd").new()
	add_child(actor)
	await frames()
	check("occupied_freeze_rejected",not world.execute(1,"freeze",id)["ok"])
	check("rejected_transition_keeps_water",world.records[id]["material"] == "water")
	actor.position = Vector3(5,0,0)
	await frames()
	check("freeze",world.execute(1,"freeze",id)["ok"])
	check("same_identity",world.views[id] == original_view)
	check("coating_survives_freeze",world.records[id]["attachments"].has("nanites"))
	check("solid_collision",world.views[id].collision_layer == 1)
	var bolt: Node3D = preload("res://scenes/actions/fire_attack.tscn").instantiate()
	bolt.direction = Vector3.RIGHT
	player.add_child(bolt)
	bolt.global_position = Vector3(-6,0.6,0)
	await frames(45)
	check("existing_projectile_damage",is_equal_approx(world.records[id]["integrity"],15.0))
	check("impact",world.execute(1,"impact",id)["ok"])
	check("shards_aggregated",world.records[id]["shape"] == "fragments" and world.views[id].fragments.multimesh.instance_count == 8)
	check("collision_removed_on_break",world.views[id].collision_layer == 0)
	check("coating_survives_shatter",world.records[id]["attachments"].has("nanites"))
	check("push",world.execute(1,"push",id,{"vector":Vector3.RIGHT*14})["ok"])
	await frames(40)
	check("shards_damage_actor",actor.health < 100.0)
	check("shards_consumed_on_hit",not world.records.has(id))
	id = create(Vector3(3,0.05,0))
	world.execute(1,"coat",id)
	var old_health: float = actor.health
	check("command",world.execute(1,"command",id,{"command":"detonate"})["ok"])
	check("blast_damage",actor.health < old_health)
	check("coating_consumed",world.records[id]["attachments"].is_empty())
	check("double_detonation_rejected",not world.execute(1,"command",id,{"command":"detonate"})["ok"])
	check("water_still_water",world.records[id]["material"] == "water")
	world.execute(1,"remove",id)
	# Phase cycle: water -> steam -> water, ice -> water, and the cloud as a sight screen.
	id = create(Vector3(0,0.05,6))
	check("heat_water",world.execute(1,"heat",id)["ok"] and world.records[id]["material"] == "steam")
	check("steam_not_solid",world.views[id].collision_layer == 0)
	var cloud_center: Vector3 = world.records[id]["position"] + Vector3.UP*1.3
	check("steam_blocks_sight",world.sight_blocked(cloud_center+Vector3(0,0,-6),cloud_center+Vector3(0,0,6)))
	check("steam_clear_beside",not world.sight_blocked(cloud_center+Vector3(6,0,-6),cloud_center+Vector3(6,0,6)))
	check("steam_not_heatable",not world.execute(1,"heat",id)["ok"])
	world.records[id]["condense"] = 0.01
	await frames(3)
	check("steam_condenses",world.records[id]["material"] == "water" and world.records[id]["shape"] == "patch")
	world.execute(1,"heat",id)
	check("freeze_condenses_steam",world.execute(1,"freeze",id)["ok"] and world.records[id]["material"] == "water")
	world.execute(1,"raise",id,{"vector":Vector3.RIGHT})
	world.execute(1,"freeze",id)
	check("heat_melts_ice_orb",world.execute(1,"heat",id)["ok"] and world.records[id]["material"] == "water" and world.records[id]["shape"] == "orb")
	var heater: Node3D = preload("res://scenes/actions/fire_attack.tscn").instantiate()
	heater.direction = Vector3(0,0,1)
	player.add_child(heater)
	heater.global_position = world.records[id]["position"] + Vector3(0,0.6,-3)
	await frames(40)
	check("bolt_boils_water",world.records.has(id) and world.records[id]["material"] == "steam")
	world.execute(1,"remove",id)
	# Nanites carried into a cloud detonate over a wider sphere than on the ground.
	id = create(Vector3(5,0.05,-5))
	world.execute(1,"coat",id)
	old_health = actor.health
	world.execute(1,"command",id,{"command":"detonate"})
	check("ground_blast_short",actor.health == old_health)
	world.execute(1,"coat",id)
	world.execute(1,"heat",id)
	check("coating_survives_boiling",world.records[id]["attachments"].has("nanites"))
	world.execute(1,"command",id,{"command":"detonate"})
	check("suspended_blast_wider",actor.health < old_health)
	world.execute(1,"remove",id)
	# Conduits: one reaction's pulse fires another construct's reaction.
	var source: int = create(Vector3(-3,0.05,-2))
	var mine: int = create(Vector3(4,0.05,-2))
	check("link_foreign_rejected",not world.execute(2,"link",source,{"to":mine})["ok"])
	check("link_self_rejected",not world.execute(1,"link",source,{"to":source})["ok"])
	check("link",world.execute(1,"link",source,{"to":mine})["ok"] and world.records[source].get("link",0) == mine)
	world.execute(1,"coat",mine)
	world.execute(1,"react",source,{"trigger":"transformed","action":"heat","vector":Vector3.ZERO})
	world.execute(1,"react",mine,{"trigger":"pulsed","action":"command","vector":Vector3.ZERO})
	old_health = actor.health
	world.execute(1,"freeze",source)
	await frames(75)
	check("pulse_relayed","pulse" in events and "pulsed" in events)
	check("chain_detonates",not world.records[mine]["attachments"].has("nanites") and actor.health < old_health)
	check("source_reaction_ran",world.records[source]["material"] == "water")
	world.execute(1,"remove",mine)
	check("conduit_cut_on_erase",not world.records[source].has("link"))
	world.execute(1,"remove",source)
	# A routine marked to chain is wired from the previous routine's construct.
	var runner: Node = world.get_node("Programs")
	var first: Dictionary = runner.start(1,{"steps":["raise"],"trigger":"broken","action":"push"},Vector3(-2,0.05,4),Vector3.FORWARD)
	await frames(30)
	runner.last_run.clear()
	var second: Dictionary = runner.start(1,{"steps":[],"trigger":"pulsed","action":"heat","chain":true},Vector3(3,0.05,4),Vector3.FORWARD)
	await frames(30)
	check("routine_chains",first["ok"] and second["ok"] and world.records.has(first["id"]) and world.records[first["id"]].get("link",0) == second["id"])
	world.execute(1,"remove",first.get("id",0))
	world.execute(1,"remove",second.get("id",0))
	# The fuller vocabulary the survivor routines compile to: verbs that refuse plain matter
	# above now act on it, under their own names, plus gravity.
	id = create(Vector3(-2,0.05,-6))
	world.execute(1,"freeze",id)
	check("lift_ice_sheet",world.execute(1,"lift",id,{"vector":Vector3.RIGHT})["ok"] and world.records[id]["shape"] == "orb" and world.records[id]["material"] == "ice")
	var tough: float = world.records[id]["integrity"]
	check("harden_ice",world.execute(1,"harden",id)["ok"] and world.records[id]["integrity"] > tough and not world.execute(1,"harden",id)["ok"])
	world.execute(1,"remove",id)
	id = create(Vector3(-2,0.05,-6))
	world.execute(1,"heat",id)
	check("scald_steam",world.execute(1,"scald",id)["ok"] and int(world.records[id].get("temp",0)) == 2)
	check("plain_heat_still_refuses_steam",not world.execute(1,"heat",id)["ok"])
	world.execute(1,"remove",id)
	id = create(Vector3(-2,0.05,-6))
	world.execute(1,"coat",id)
	check("second_coat_charges",world.execute(1,"charge",id)["ok"] and int(world.records[id]["attachments"]["nanites"]["charge"]) == 2)
	world.execute(1,"remove",id)
	id = create(Vector3(-2,0.05,-6))
	var wave_from: Vector3 = world.records[id]["position"]
	check("water_slides",world.execute(1,"slide",id,{"vector":Vector3(0,0,8)})["ok"])
	await frames(20)
	check("wave_travels",world.records.has(id) and world.records[id]["position"].distance_to(wave_from) > 1.0)
	world.execute(1,"remove",id)
	actor.position = Vector3(0,0,-2)
	await frames()
	id = create(Vector3(0,0.05,-8))
	world.execute(1,"freeze",id)
	old_health = actor.health
	world.execute(1,"slide",id,{"vector":Vector3(0,0,10)})
	await frames(60)
	check("ice_ram_hits_and_breaks",actor.health < old_health and (not world.records.has(id) or world.records[id]["shape"] == "fragments"))
	if world.records.has(id): world.execute(1,"remove",id)
	# Gravity: a well draws a cloud in, a repulsor throws shards out, a drop crushes and breaks.
	var well: int = create(Vector3(-7,0.05,-7))
	var cloud: int = create(Vector3(-2,0.05,-7))
	world.execute(1,"heat",cloud)
	var gap: float = world.records[cloud]["position"].distance_to(world.records[well]["position"])
	check("well",world.execute(1,"well",well,{"vector":Vector3.LEFT})["ok"] and int(world.records[well].get("grav",0)) == 1)
	# Charge: the matter holds up to two; the survivor's conduction rule spends it.
	check("arc_charges",world.execute(1,"arc",cloud)["ok"] and world.execute(1,"arc",cloud)["ok"] and not world.execute(1,"arc",cloud)["ok"] and int(world.records[cloud]["charge"]) == 2)
	await frames(40)
	check("well_draws_loose_matter",world.records.has(cloud) and world.records[cloud]["position"].distance_to(world.records[well]["position"]) < gap - 0.3)
	world.execute(1,"remove",cloud)
	var shards: int = create(Vector3(-4,0.05,-7))
	world.execute(1,"freeze",shards)
	world.execute(1,"impact",shards)
	world.execute(1,"repel",well,{"vector":Vector3.LEFT})
	# The repulsor's front runs out at its own speed; give it time to reach them.
	await frames(30)
	check("repel_throws_shards",world.records.has(shards) and world.records[shards]["velocity"].x > 1.0)
	if world.records.has(shards): world.execute(1,"remove",shards)
	world.execute(1,"remove",well)
	actor.position = Vector3(0,0,-5.4)
	await frames()
	id = create(Vector3(0,0.05,-7.2))
	world.execute(1,"raise",id,{"vector":Vector3.RIGHT})
	check("orb_freezes_for_drop",world.execute(1,"freeze",id)["ok"])
	old_health = actor.health
	check("drop",world.execute(1,"drop",id,{"vector":Vector3(0,0,1)})["ok"])
	check("drop_crushes",actor.health < old_health)
	check("dropped_ice_breaks",world.records.has(id) and world.records[id]["shape"] == "fragments")
	world.execute(1,"remove",id)
	id = create(Vector3(-3,0.05,-9))
	world.execute(1,"heat",id)
	check("drop_rains_steam_down",world.execute(1,"drop",id)["ok"] and world.records[id]["material"] == "water" and world.records[id]["shape"] == "patch")
	# Only the host's own scheduling may act on matter out of its owner's reach.
	player.position = Vector3(-40,0,0)
	world.request_operation("remove",id,{"remote": true})
	check("client_cannot_claim_remote",world.records.has(id))
	check("host_reaction_acts_out_of_reach",not world.execute(1,"remove",id)["ok"] and world.execute(1,"remove",id,{"remote": true})["ok"])
	player.position = Vector3(-4,0,0)
	actor.position = Vector3(5,0,0)
	await frames()
	var base_count: int = world.get_child_count()
	for i in 40:
		id = create()
		world.execute(1,"freeze",id)
		world.execute(1,"remove",id)
		await frames()
	check("cycle_cleanup",world.records.is_empty() and world.views.is_empty() and world.get_child_count() == base_count)
	for i in 8: create(Vector3(i,0.05,-4))
	check("owner_cap",not world.execute(1,"create",0,{"point":Vector3.ZERO})["ok"])
	for record: Dictionary in world.records.values(): record["ttl"] = 0.01
	await frames(10)
	check("lifetime_cleanup",world.records.is_empty() and world.get_child_count() == base_count)
	for kind: String in ["created","coated","reshaped","transformed","hit","broken","impulsed","collided","commanded","detonated","removed","expired","linked","pulse","pulsed","well","repelled","dropped","charged"]:
		check("event_"+kind,kind in events)
	for peer_id in [3,4]:
		var peer_player := Node3D.new()
		peer_player.set_multiplayer_authority(peer_id)
		peer_player.add_to_group("coop_players")
		add_child(peer_player)
	for index in 32:
		var owner_id: int = 1 + index / 8
		var position := Vector3((float(index % 8)-3.5)*6,0.05,(float(index / 8)-1.5)*6)
		world._player(owner_id).global_position = position + Vector3.LEFT
		var made: Dictionary = world.execute(owner_id,"create",0,{"point":position})
		check("benchmark_create",made["ok"])
		var matter_id: int = made.get("id",0)
		world.execute(owner_id,"freeze",matter_id)
		world.execute(owner_id,"impact",matter_id)
		world.execute(owner_id,"push",matter_id,{"vector":Vector3(0,0,2)})
	var count_at_limit: int = world.records.size()
	check("global_capacity",count_at_limit == 32)
	var full_bytes: int = world.snapshot_bytes
	var total_before: int = world.tick_usec_total
	var ticks_before: int = world.tick_count
	await frames(120)
	var mean_usec: float = float(world.tick_usec_total-total_before)/maxi(1,world.tick_count-ticks_before)
	for record: Dictionary in world.records.values(): record["ttl"] = 0.01
	await frames(10)
	check("capacity_cleanup",world.records.is_empty() and world.get_child_count() == base_count)
	var failures: Array = checks.keys().filter(func(key): return not checks[key])
	var report := {"checks":checks,"failures":failures,"event_count":events.size(),"max_tick_usec":world.tick_usec_max,"capacity_count":count_at_limit,"moving_tick_mean_usec":mean_usec,"capacity_snapshot_bytes":full_bytes,"last_snapshot_bytes":world.snapshot_bytes}
	var args := OS.get_cmdline_user_args()
	if not args.is_empty(): FileAccess.open(args[0],FileAccess.WRITE).store_string(JSON.stringify(report,"  "))
	print("MATTER ","PASS" if failures.is_empty() else "FAIL", " ",JSON.stringify(report))
	get_tree().quit(0 if failures.is_empty() else 1)
