      "B03"
    ],
    "modes": {
      "world_space": "use node world position; every reactive object also carries cs_local_u/v/w normalised inside its owner bounds",
      "route": "use cs_route_index and cs_phase_offset on the OWNER node; index order is travel order"
    },
    "wave_parameters": [
      "wave_origin",
      "wave_direction",
      "wave_speed",
      "wave_width",
      "wave_intensity",
      "wave_phase",
      "wave_falloff"
    ],
    "shader_sketch": "phase = dot(vec3(cs_local_u, cs_local_v, cs_local_w), wave_direction) - time * wave_speed"
  },
