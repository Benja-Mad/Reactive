  "conventions": {
    "root_node": "CS_REACTIVE",
    "properties": {
      "cs_reactive": "1 on anything Godot may drive at runtime",
      "cs_group": "trigger key - drive a whole group at once",
      "cs_building": "owner id (B01..B05, SPINE, YARD, BGCITY)",
      "cs_channel": "which facade layer this object belongs to",
      "cs_system": "power | network | thermal | security | bio | structural",
      "cs_facade_role": "residential | commercial | industrial | megablock | infrastructure | backdrop | vegetation",
      "cs_signals": "comma list of gameplay signals expected to drive it",
      "cs_default_state": "state to restore to",
      "cs_prog": "programmable role (pre-existing)",
      "cs_shader": "animation hint: uv_scroll | pulse_scroll | hologram_flicker | barrier_scan | glitch_displace",
      "cs_state": "semantic colour key (pre-existing)",
      "cs_band": "FG | PLAY | BG_NEAR | BG_FAR",
      "cs_local_u/v/w": "position inside owner bounds, 0..1 - the wave input",
      "cs_route_index": "position along the propagation route, -1 if off-route",
      "cs_phase_offset": "0..1 delay along the route, on the owner node",
      "cs_grid_x/y": "logical window-grid cell, on pattern-capable owners",
      "cs_bounds_min/max": "owner AABB, on the owner node",
      "cs_pattern_grid": "[cols, rows] logical grid, on the owner node"
    },
    "static_batch": "objects with cs_reactive == 0 are never driven and can be merged/batched freely"
  },
